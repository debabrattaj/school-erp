# Python
backend/venv/
__pycache__/
*.pyc

# Secrets
backend/.env
backend/.env.bak.*
frontend/.env
frontend/.env.local

# Databases (per-tenant SQLite files — real data shouldn't ship with source)
backend/*.db
backend/*.db-journal

# Logs
backend/*.log

# Frontend (has its own .gitignore too)
frontend/node_modules/
frontend/dist/

# cPanel Setup Node.js App leftovers (placeholder startup file + its own
# tmp dir, written directly into frontend/ since that's the Application root)
frontend/index.js
frontend/tmp/

# Windows shell artifacts
desktop.ini
*.lnk

# OS
.DS_Store

# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# Local database backups (created before destructive DB operations)
db_backups/
backend/backups/


# Locally-installed libs (deploys install from requirements.txt)
backend/.pylibs/

# Uploaded files
backend/uploads/

# Proctoring webcam snapshots -- private, never served statically (see
# backend/app/proctoring_storage.py)
backend/uploads_private/

# Passenger's restart-trigger file/directory (touched by .cpanel.yml on
# deploy; pure runtime state, nothing to track)
backend/tmp/

# Developer-machine file listings (e.g. `dir /s` on Windows) accidentally
# committed once before -- not product-relevant, may leak a local path/username.
PROJECT_FILE_LIST.txt
