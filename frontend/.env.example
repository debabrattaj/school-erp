# URL of the deployed backend API (e.g. https://school-erp-api.onrender.com)
# In local dev this defaults to http://127.0.0.1:8000 if unset.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Only needed if this deployment is served from a subpath instead of the
# domain root (e.g. a cPanel host that also serves a separate marketing
# site at the root, with this app mounted at /school-admin/). Leave unset
# to serve from the root, which is the default for Vercel/local dev.
# VITE_BASE_PATH=/school-admin/
