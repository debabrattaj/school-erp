{
  "expo": {
    "name": "School ERP",
    "slug": "school-erp-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "schoolerp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schoolerp.portal",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.schoolerp.portal",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to choose a photo for student and staff records.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to take a photo for student and staff records."
        }
      ],
      "./plugins/withAndroidNetworkSecurityConfig.js"
    ],
    "extra": {
      "eas": {
        "projectId": "31b082ce-b579-4eef-bc01-5869aab18f54"
      }
    }
  }
}
