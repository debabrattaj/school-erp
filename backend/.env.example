# Copy this file to `.env` in the same folder (backend/.env) and fill in real values.
# The app will NOT start without SECRET_KEY set.

# --- Required ---
# Used to sign JWT auth tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# --- Optional (defaults shown) ---
# How long a login token stays valid, in minutes. Default: 1440 (24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of browser origins allowed to call this API (CORS).
# Default: the local Vite dev servers. In production set this to your real
# frontend URL(s), e.g. https://app.yourschool.com,https://admin.yourschool.com
# A wildcard "*" is NOT allowed because the API uses credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login brute-force throttling. After LOGIN_MAX_ATTEMPTS failed logins from the
# same IP or against the same email within LOGIN_WINDOW_SECONDS, further
# attempts are blocked (HTTP 429) until the window passes.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900

# --- Self-service password reset ---
# How long a reset link stays valid, in minutes. Default: 30
RESET_TOKEN_TTL_MINUTES=30
# Minimum length for a password chosen via reset. Default: 8
MIN_PASSWORD_LENGTH=8
# Frontend base URL used to build the reset link in the (currently logged) email.
FRONTEND_BASE_URL=http://localhost:5173
# Backend base URL used to build the public fee-payment link sent to guardians
# over WhatsApp/SMS (e.g. https://school-erp-api.onrender.com). Must be
# reachable by the guardian's phone, not just the app's own frontend.
BACKEND_BASE_URL=http://localhost:8000
# DEV ONLY: when true, /auth/forgot-password returns the reset token in its JSON
# response so the flow is testable without an email transport. NEVER enable in
# production — it would let anyone reset any account. Default: false
RESET_DEBUG_RETURN_TOKEN=false

# --- Email (SMTP) ---
# Leave SMTP_HOST empty to run in log-only mode: outgoing emails (e.g. password
# reset links) are written to the server log instead of being sent. Set these
# to a real SMTP provider to actually deliver mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@schoolerp.local
# STARTTLS (typical for port 587). Set false + SMTP_USE_SSL=true for port 465.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

# --- WhatsApp (Twilio) ---
# Used for both the WhatsApp and SMS communication channels (SMS is sent over
# WhatsApp). Leave TWILIO_ACCOUNT_SID empty for log-only mode: messages are
# logged instead of sent. Set all three to deliver via Twilio's WhatsApp API.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Prepended to local numbers that lack a leading '+'. Default: +91 (India).
WHATSAPP_DEFAULT_COUNTRY_CODE=+91
WHATSAPP_TIMEOUT=10

# --- AI Assistant (Claude) ---
# The chatbot (Assistant page / floating widget, "Sai") has two engines:
#   - No key set: deterministic keyword matching (app/routes/chatbot.py).
#     Works fully offline, no external API calls, no key needed.
#   - ANTHROPIC_API_KEY set: a real Claude tool-calling agent
#     (app/ai_assistant.py) drives the whole conversation -- free-form
#     phrasing, follow-ups, multi-turn context. Claude never queries the
#     database directly; it calls small tools (get_attendance, get_fees,
#     ...) that are each independently re-checked against the caller's own
#     access before touching data, so a parent account can never read
#     another family's student even if the model is tricked into trying.
# Switching to the AI engine needs nothing else -- set the key and the next
# request uses it. Leave empty to keep the assistant on keyword-matching.
ANTHROPIC_API_KEY=

# --- File uploads (student photos, certificates, documents) ---
# On platforms with an ephemeral filesystem (e.g. Render without a persistent
# disk attached), files written here are lost on every redeploy/restart.
UPLOAD_DIR=./uploads

# --- Proctoring webcam snapshots (Online Exam Proctoring add-on, Phase 2) ---
# Deliberately a SEPARATE directory from UPLOAD_DIR above: UPLOAD_DIR is
# mounted as a public static path at /uploads, but a webcam snapshot of a
# student must only ever be reachable through the authenticated teacher
# review endpoint. Never point this at UPLOAD_DIR or mount it statically.
# Same ephemeral-filesystem caveat as UPLOAD_DIR applies.
PROCTORING_UPLOAD_DIR=./uploads_private/proctoring
# Per-frame size cap; a single JPEG webcam frame is normally well under 1 MB.
MAX_PROCTORING_SNAPSHOT_MB=2

# --- Database backups ---
# The owner console can always trigger a backup on demand. Set BACKUP_ENABLED
# true to also run them automatically on a schedule.
BACKUP_DIR=./backups
BACKUP_KEEP=14
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24

# Central "directory" DB that maps school/account codes to their own database.
# SQLite by default; for Postgres use e.g.
#   postgresql+psycopg://user:pass@localhost:5432/school_accounts
CENTRAL_DATABASE_URL=sqlite:///./school_accounts.db

# Account code used when no tenant is specified (e.g. local dev, single-school setup).
# Default: default
DEFAULT_ACCOUNT_CODE=default

# Database used for the default/single-tenant school. SQLite by default; for
# Postgres use e.g. postgresql+psycopg://user:pass@localhost:5432/school_erp
DEFAULT_SCHOOL_DATABASE_URL=sqlite:///./school_erp.db

# NOTE ON POSTGRES: install the driver with `pip install "psycopg[binary]"`
# (already in requirements.txt). New tenant databases are auto-created
# (CREATE DATABASE) if the connecting role has permission; otherwise create
# them up front. On Render this runs automatically on every boot (see
# render.yaml's startCommand); elsewhere run it yourself with
# `python manage_migrations.py upgrade head`.
# Backups of Postgres DBs use `pg_dump` (must be on PATH) producing .sql files.

# --- Online payment (UPI) ---
# Fee payments use a direct UPI deep link / QR to the school's UPI ID. There is
# no env var for it: set the UPI ID per school under Settings -> Finance. Leave
# it empty there to hide the Pay via UPI button.

# --- Online payment (Razorpay Route -- card/netbanking/etc) ---
# These are the PLATFORM's own Razorpay master account: every school's fees
# flow through it, and Razorpay's Route feature auto-splits each school's
# share into its own linked account (set per school in the Platform Console
# as razorpay_linked_account_id) while keeping the platform's commission
# behind. Deliberately not stored in the database -- see app/payments.py's
# platform_credentials(). Leave empty and a school can still collect
# payments if it configures its own separate gateway account under
# Fees -> Online Payments -> Gateway Settings (payment_provider/key_id/
# key_secret, stored per school) -- Route is preferred when both this and a
# school's linked account id are set, that school's own keys are the
# fallback.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Demo data ---
# On startup the app seeds four demo users with well-known passwords
# (admin@school.com/admin123, principal, accounts, teacher). Handy for dev
# and first-run, but a real deployment must disable this once actual admin
# accounts exist — the passwords are public knowledge.
SEED_DEMO_USERS=true
