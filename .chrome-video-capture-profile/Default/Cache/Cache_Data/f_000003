; }\r\n.widget-card-dragging { opacity: 0.45; }\r\n.widget-card-dragover { outline: 2px dashed var(--saas-primary); outline-offset: 3px; }\r\n.widget-title-row { display: flex; align-items: center; gap: 6px; }\r\n.widget-grip { color: var(--saas-border-strong); cursor: grab; display: inline-flex; align-items: center; }\r\n.widget-grip:active { cursor: grabbing; }\r\n.widget-card[draggable=\"true\"] .widget-head { cursor: grab; }\r\n\r\n/* Portal: parent-teacher messages */\r\n.portal-messages {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n}\r\n\r\n.portal-messages-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n  max-height: 420px;\r\n  overflow-y: auto;\r\n  padding: 4px 2px;\r\n}\r\n\r\n.portal-message {\r\n  max-width: 70%;\r\n  padding: 10px 14px;\r\n  border-radius: 14px;\r\n  background: var(--saas-surface, var(--surface-subtle));\r\n  border: 1px solid var(--saas-border);\r\n}\r\n\r\n.portal-message p {\r\n  margin: 4px 0 0;\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n}\r\n\r\n.portal-message-meta {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: baseline;\r\n  font-size: 12px;\r\n  color: var(--saas-text-muted, var(--text-muted));\r\n}\r\n\r\n/* Homework hand-in and study material: a card per item, since each one\r\n   carries its own form/actions and does not fit a table row. */\r\n.portal-stack {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n}\r\n\r\n.portal-card {\r\n  border: 1px solid var(--saas-border);\r\n  border-radius: 12px;\r\n  padding: 16px 18px;\r\n  background: var(--saas-surface, var(--surface-subtle));\r\n  box-shadow: var(--saas-shadow-sm);\r\n}\r\n\r\n.portal-card-title {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex-wrap: wrap;\r\n  font-weight: 700;\r\n}\r\n\r\n.portal-card-meta {\r\n  font-size: 13px;\r\n  color: var(--saas-text-muted, var(--text-muted));\r\n  margin-top: 2px;\r\n}\r\n\r\n.portal-card p {\r\n  margin: 8px 0 0;\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n}\r\n\r\n/* The already-handed-in / graded panel, nested inside its assignment card. */\r\n.portal-card-inset {\r\n  margin-top: 12px;\r\n  padding: 12px 14px;\r\n  border-radius: 10px;\r\n  background: var(--surface-soft, var(--surface-subtle));\r\n  border: 1px solid var(--saas-border);\r\n}\r\n\r\n.portal-card-actions {\r\n  margin-top: 12px;\r\n}\r\n\r\n.portal-message-staff {\r\n  align-self: flex-start;\r\n}\r\n\r\n.portal-message-self {\r\n  align-self: flex-end;\r\n  background: color-mix(in srgb, var(--saas-primary) 12%, white);\r\n  border-color: color-mix(in srgb, var(--saas-primary) 30%, var(--saas-border));\r\n}\r\n\r\n.portal-message-form {\r\n  display: flex;\r\n  gap: 10px;\r\n  align-items: flex-end;\r\n  border-top: 1px solid var(--saas-border);\r\n  padding-top: 14px;\r\n}\r\n\r\n.portal-message-form textarea {\r\n  flex: 1;\r\n  resize: vertical;\r\n  min-height: 42px;\r\n  border: 1px solid var(--saas-border);\r\n  border-radius: 10px;\r\n  padding: 10px 12px;\r\n  font-family: inherit;\r\n  font-size: 14px;\r\n}\r\n\r\n.portal-message-form button {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* Portal: online test runner */\r\n.online-test-runner {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 18px;\r\n}\r\n\r\n.online-test-runner-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: flex-start;\r\n  border-bottom: 1px solid var(--saas-border);\r\n  padding-bottom: 12px;\r\n}\r\n\r\n.online-test-runner-header h3 {\r\n  margin: 0 0 4px;\r\n}\r\n\r\n.online-test-runner-header p {\r\n  margin: 0;\r\n  color: var(--saas-text-muted, var(--text-muted));\r\n}\r\n\r\n.online-test-timer {\r\n  font-weight: 800;\r\n  font-size: 18px;\r\n  color: var(--saas-primary);\r\n  white-space: nowrap;\r\n}\r\n\r\n.online-test-question {\r\n  border: 1px solid var(--saas-border);\r\n  border-radius: 12px;\r\n  padding: 14px 16px;\r\n}\r\n\r\n.online-test-question-text {\r\n  margin: 0 0 10px;\r\n  font-weight: 700;\r\n}\r\n\r\n.online-test-question-marks {\r\n  font-weight: 500;\r\n  color: var(--saas-text-muted, var(--text-muted));\r\n}\r\n\r\n.online-test-options {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.online-test-option {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  border: 1px solid var(--saas-border);\r\n  border-radius: 8px;\r\n  padding: 8px 12px;\r\n  cursor: pointer;\r\n}\r\n\r\n.online-test-option-selected {\r\n  border-color: var(--saas-primary);\r\n  background: color-mix(in srgb, var(--saas-primary) 8%, white);\r\n}\r\n\r\n.online-test-option-correct {\r\n  border-color: var(--success-600);\r\n  background: var(--success-50);\r\n}\r\n\r\n.online-test-option-wrong {\r\n  border-color: var(--danger-600);\r\n  background: var(--danger-50);\r\n}\r\n\r\n/* ===========================================================================\r\n * SaaS shell\r\n *\r\n * A deliberate visual pass over the chrome, appended last so it wins on equal\r\n * specificity without surgery on eight thousand lines above.\r\n *\r\n * The brief was \"feel like a SaaS product, not an ordinary app\". What\r\n * separates the two is almost never colour -- it is restraint. Working\r\n * software gets out of the way: quieter navigation, smaller headings, denser\r\n * tables, flat surfaces, and colour spent only where it means something. The\r\n * rules below trade decoration for information density.\r\n * ========================================================================= */\r\n\r\n/* --- Typography: an app scale, not a marketing one ---------------------- */\r\n\r\nbody {\r\n  font-size: 14px;\r\n  line-height: 1.5;\r\n  -webkit-font-smoothing: antialiased;\r\n  background: var(--bg-app);\r\n}\r\n\r\nh1, .page-heading.page-heading.page-heading h2, .page-head.page-head h1 {\r\n  font-size: 20px;\r\n  font-weight: 650;\r\n  letter-spacing: -0.01em;\r\n  color: var(--text-strong);\r\n  margin: 0;\r\n}\r\n\r\nh2 { font-size: 17px; font-weight: 650; letter-spacing: -0.01em; }\r\nh3 { font-size: 14px; font-weight: 650; }\r\n\r\n/* The eyebrow above every page title was a line of shouting that told the\r\n   user where they already knew they were. */\r\n.page-heading.page-heading.page-heading .eyebrow.eyebrow.eyebrow,\r\n.eyebrow.eyebrow.eyebrow {\r\n  display: none;\r\n}\r\n\r\n/* --- Page header: one compact row -------------------------------------- */\r\n\r\n.page-head,\r\n.page-heading.page-heading.page-heading {\r\n  /* Page-level rules set a min-height to make the old banner-style header\r\n     feel substantial. A compact header should be as tall as its content. */\r\n  min-height: 0;\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  flex-wrap: wrap;\r\n  gap: 16px;\r\n  background: transparent;\r\n  border: 0;\r\n  box-shadow: none;\r\n  padding: 0 0 8px;\r\n  margin: 0 0 8px;\r\n}\r\n\r\n/* Once the title text and the action row can no longer share one line, the\r\n   whole action row drops to a line of its own -- rather than getting\r\n   squeezed into whatever sliver is left beside the title, which is what\r\n   forced individual buttons to wrap one at a time (see .student-edit-page's\r\n   and :has(.form-panel)'s own justify-content: flex-end below, patched\r\n   piecemeal for the same reason before this exists here). This is why a\r\n   title's own div needs no explicit width: as a flex item it already claims\r\n   however much space it needs up to the point the row wraps. */\r\n.page-heading.page-heading.page-heading .module-header-actions {\r\n  justify-content: flex-end;\r\n  margin-left: auto;\r\n}\r\n\r\n.page-head.page-head p,\r\n.page-heading.page-heading.page-heading p {\r\n  margin: 3px 0 0;\r\n  font-size: 13px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* --- Sidebar: navigation should whisper -------------------------------- */\r\n\r\n.sidebar {\r\n  background: var(--surface);\r\n  border-right: 1px solid var(--border);\r\n}\r\n\r\n.menu-group-label.menu-group-label,\r\n.sidebar-group-label {\r\n  text-transform: none;\r\n  letter-spacing: 0;\r\n  font-size: 11.5px;\r\n  font-weight: 600;\r\n  color: var(--text-subtle);\r\n  padding: 14px 14px 5px;\r\n  line-height: 1.3;\r\n}\r\n\r\n.sidebar-menu a {\r\n  font-size: 13.5px;\r\n  font-weight: 500;\r\n  color: var(--text);\r\n  border-radius: var(--radius-sm);\r\n  margin: 1px 8px;\r\n  padding: 7px 10px;\r\n  border-left: 0;\r\n  transition: background-color 120ms ease, color 120ms ease;\r\n}\r\n\r\n.sidebar-menu a.active,\r\n.sidebar-menu a[aria-current=\"page\"] {\r\n  background: var(--primary-soft);\r\n  color: var(--primary);\r\n  font-weight: 600;\r\n  border-left: 0;\r\n  box-shadow: none;\r\n}\r\n\r\n/* --- Topbar: shorter, quieter ------------------------------------------ */\r\n\r\n.topbar.topbar {\r\n  background: var(--surface);\r\n  border-bottom: 1px solid var(--border);\r\n  box-shadow: none;\r\n  padding-top: 8px;\r\n  padding-bottom: 8px;\r\n}\r\n\r\n.topbar-identity {\r\n  width: 32px;\r\n  height: 32px;\r\n  border-radius: var(--radius-pill);\r\n  border: 1px solid var(--border);\r\n  background: var(--surface-soft);\r\n  color: var(--text);\r\n  font-size: 12.5px;\r\n  font-weight: 650;\r\n  cursor: pointer;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  transition: background-color 120ms ease;\r\n}\r\n\r\n.topbar-identity:hover { background: var(--border); }\r\n\r\n.topbar-account { position: relative; }\r\n\r\n.topbar-account-menu {\r\n  position: absolute;\r\n  right: 0;\r\n  top: calc(100% + 8px);\r\n  min-width: 208px;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--radius);\r\n  box-shadow: var(--shadow-lg);\r\n  padding: 5px;\r\n  z-index: 60;\r\n}\r\n\r\n.topbar-account-head {\r\n  padding: 8px 10px 10px;\r\n  border-bottom: 1px solid var(--border);\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.topbar-account-name { font-size: 13px; font-weight: 650; color: var(--text-strong); }\r\n.topbar-account-role { font-size: 12px; color: var(--text-muted); margin-top: 1px; }\r\n\r\n.topbar-account-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 9px;\r\n  width: 100%;\r\n  padding: 8px 10px;\r\n  background: transparent;\r\n  border: 0;\r\n  border-radius: var(--radius-sm);\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  color: var(--text);\r\n  cursor: pointer;\r\n  text-align: left;\r\n}\r\n\r\n.topbar-account-item:hover { background: var(--surface-soft); }\r\n.topbar-account-item-danger { color: var(--danger-600); }\r\n.topbar-account-item-danger:hover { background: var(--danger-50); }\r\n\r\n/* --- Surfaces: flat, bordered, not floating ---------------------------- */\r\n\r\n.form-panel.form-panel,\r\n.summary-card,\r\n.card,\r\n.table-card,\r\n.panel {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--radius-lg);\r\n  box-shadow: var(--shadow-sm);\r\n}\r\n\r\n.panel-header {\r\n  padding-bottom: 12px;\r\n  border-bottom: 1px solid var(--border);\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.panel-header p {\r\n  font-size: 12.5px;\r\n  color: var(--text-muted);\r\n  margin: 3px 0 0;\r\n}\r\n\r\n/* --- Stat cards: the number is the point ------------------------------- */\r\n\r\n.stat-card.stat-card {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--radius-lg);\r\n  box-shadow: none;\r\n  padding: 16px;\r\n  transition: border-color 140ms ease, box-shadow 140ms ease;\r\n}\r\n\r\n.stat-card:hover {\r\n  border-color: var(--border-strong);\r\n  box-shadow: var(--shadow-sm);\r\n  transform: none;\r\n}\r\n\r\n/* The pale blobs in each corner were decoration with nothing to say. */\r\n.stat-card::after,\r\n.stat-card:hover::after {\r\n  display: none;\r\n}\r\n\r\n.stat-card.stat-card p { font-size: 12.5px; font-weight: 550; color: var(--text-muted); }\r\n.stat-card.stat-card h3 { font-size: 25px; font-weight: 680; letter-spacing: -0.02em; color: var(--text-strong); }\r\n.stat-card.stat-card span { font-size: 12px; color: var(--text-subtle); }\r\n\r\n.stat-card.stat-card .stat-icon,\r\n.stat-card.stat-card-icon {\r\n  border-radius: var(--radius);\r\n  box-shadow: none;\r\n}\r\n\r\n/* --- Tables: the workhorse of a B2B product ---------------------------- */\r\n\r\ntable { font-size: 13px; }\r\n\r\nthead th {\r\n  font-size: 11.5px;\r\n  font-weight: 620;\r\n  letter-spacing: 0.02em;\r\n  text-transform: uppercase;\r\n  color: var(--text-muted);\r\n  background: var(--surface-subtle);\r\n  border-bottom: 1px solid var(--border);\r\n  padding: 9px 12px;\r\n  white-space: nowrap;\r\n}\r\n\r\ntbody td {\r\n  padding: 10px 12px;\r\n  border-bottom: 1px solid var(--border);\r\n  color: var(--text);\r\n}\r\n\r\ntbody tr { transition: background-color 100ms ease; }\r\ntbody tr:hover { background: var(--surface-subtle); }\r\ntbody tr:last-child td { border-bottom: 0; }\r\n\r\n/* --- Buttons: one loud one per screen, at most ------------------------- */\r\n\r\n.primary-button.primary-button,\r\nbutton.primary,\r\n.btn.primary {\r\n  background: var(--primary);\r\n  border: 1px solid var(--primary);\r\n  color: var(--text-on-brand);\r\n  border-radius: var(--radius);\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  padding: 8px 14px;\r\n  box-shadow: none;\r\n  transition: background-color 120ms ease;\r\n}\r\n\r\n.primary-button:hover,\r\nbutton.primary:hover,\r\n.btn.primary:hover {\r\n  background: var(--primary-hover);\r\n  border-color: var(--primary-hover);\r\n  transform: none;\r\n}\r\n\r\n.secondary-button.secondary-button,\r\n.light-button.light-button,\r\n.btn.secondary {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border-strong);\r\n  color: var(--text);\r\n  border-radius: var(--radius);\r\n  font-size: 13px;\r\n  font-weight: 550;\r\n  padding: 8px 14px;\r\n  box-shadow: none;\r\n}\r\n\r\n.secondary-button:hover,\r\n.light-button:hover,\r\n.btn.secondary:hover {\r\n  background: var(--surface-subtle);\r\n  border-color: var(--text-subtle);\r\n}\r\n\r\n/* Keyboard users deserve to see where they are. */\r\na:focus-visible,\r\nbutton:focus-visible,\r\ninput:focus-visible,\r\nselect:focus-visible,\r\ntextarea:focus-visible {\r\n  outline: 2px solid var(--primary);\r\n  outline-offset: 1px;\r\n  border-radius: var(--radius-sm);\r\n}\r\n\r\n/* --- Inputs ------------------------------------------------------------ */\r\n\r\n.form-field label {\r\n  font-size: 12.5px;\r\n  font-weight: 600;\r\n  color: var(--text);\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.form-field input,\r\n.form-field select,\r\n.form-field textarea {\r\n  font-size: 13.5px;\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: var(--radius);\r\n  padding: 8px 11px;\r\n  background: var(--surface);\r\n  color: var(--text-strong);\r\n  transition: border-color 120ms ease, box-shadow 120ms ease;\r\n}\r\n\r\n.form-field input:focus,\r\n.form-field select:focus,\r\n.form-field textarea:focus {\r\n  border-color: var(--primary);\r\n  box-shadow: 0 0 0 3px var(--focus-ring);\r\n  outline: none;\r\n}\r\n\r\n/* --- CustomSelect: a native <select>'s open option list is rendered by\r\n   the OS, not the page, so no CSS here can touch it. This is a styled\r\n   stand-in with the same look everywhere a form field gets one. ------- */\r\n\r\n.custom-select {\r\n  position: relative;\r\n  min-width: 0;\r\n}\r\n\r\n.custom-select-trigger {\r\n  width: 100%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  font-size: 13.5px;\r\n  font-family: inherit;\r\n  text-align: left;\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: var(--radius);\r\n  padding: 8px 11px;\r\n  background: var(--surface);\r\n  color: var(--text-strong);\r\n  cursor: pointer;\r\n  transition: border-color 120ms ease, box-shadow 120ms ease;\r\n}\r\n\r\n.custom-select-trigger:hover {\r\n  border-color: var(--primary);\r\n}\r\n\r\n.custom-select-trigger:focus-visible,\r\n.custom-select-trigger[aria-expanded=\"true\"] {\r\n  border-color: var(--primary);\r\n  box-shadow: 0 0 0 3px var(--focus-ring);\r\n  outline: none;\r\n}\r\n\r\n.custom-select-trigger:disabled {\r\n  cursor: not-allowed;\r\n  opacity: 0.6;\r\n}\r\n\r\n.custom-select-placeholder {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.custom-select-chevron {\r\n  flex-shrink: 0;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.custom-select-panel {\r\n  list-style: none;\r\n  margin: 6px 0 0;\r\n  padding: 6px;\r\n  position: absolute;\r\n  top: 100%;\r\n  left: 0;\r\n  right: 0;\r\n  z-index: 40;\r\n  max-height: 264px;\r\n  overflow-y: auto;\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--radius);\r\n  box-shadow: var(--shadow-md);\r\n}\r\n\r\n.custom-select-option {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  font-size: 13.5px;\r\n  color: var(--text-strong);\r\n  padding: 8px 10px;\r\n  border-radius: calc(var(--radius) - 4px);\r\n  cursor: pointer;\r\n}\r\n\r\n.custom-select-option.is-highlighted {\r\n  background: var(--surface-soft);\r\n}\r\n\r\n.custom-select-option.is-selected {\r\n  background: var(--primary-soft);\r\n  color: var(--primary);\r\n  font-weight: 600;\r\n}\r\n\r\n.custom-select-option.is-selected svg {\r\n  color: var(--primary);\r\n}\r\n\r\n/* --- Empty states: offer the next action ------------------------------- */\r\n\r\n.empty-table,\r\n.empty-state {\r\n  padding: 44px 24px;\r\n  text-align: center;\r\n  color: var(--text-muted);\r\n  font-size: 13.5px;\r\n}\r\n\r\n/* --- The assistant should not shout over the page ---------------------- */\r\n\r\n.chat-widget-toggle,\r\n.chat-fab {\r\n  box-shadow: var(--shadow-md);\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n}\r\n\r\n/* The assistant was a wide labelled pill floating over every screen, reading\r\n   louder than the page's own primary action. A circular icon button is the\r\n   convention for a reason: present, reachable, not competing. */\r\n.floating-assistant-toggle.floating-assistant-toggle {\r\n  width: 54px;\r\n  height: 54px;\r\n  padding: 0;\r\n  border-radius: var(--radius-pill);\r\n  font-size: 0;\r\n  gap: 0;\r\n  justify-content: center;\r\n  background: linear-gradient(135deg, var(--brand-400), var(--primary));\r\n  border: none;\r\n  box-shadow: 0 10px 24px rgba(37, 41, 219, 0.35), 0 2px 6px rgba(15, 23, 42, 0.12);\r\n  transition: transform 150ms ease, box-shadow 150ms ease;\r\n}\r\n\r\n.floating-assistant-toggle.floating-assistant-toggle:hover {\r\n  background: linear-gradient(135deg, var(--brand-400), var(--primary-hover));\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 14px 30px rgba(37, 41, 219, 0.4), 0 4px 10px rgba(15, 23, 42, 0.14);\r\n}\r\n\r\n.floating-assistant-toggle.floating-assistant-toggle:active {\r\n  transform: translateY(0);\r\n}\r\n\r\n/* The button is a flex row that used to hold an icon and a label. With the\r\n   label gone the icon was left to absorb the shrink and collapsed to 2px\r\n   wide -- visible only as a sliver, which is worse than no button at all. */\r\n.floating-assistant-toggle.floating-assistant-toggle svg {\r\n  flex: 0 0 auto;\r\n  width: 23px;\r\n  height: 23px;\r\n}\r\n\r\n/* Dashboard section cards should not out-shout the numbers above them. */\r\n.dashboard .form-panel.form-panel,\r\n.dashboard .panel.panel {\r\n  box-shadow: var(--shadow-sm);\r\n}\r\n\r\n/* ---------------------------------------------------------------------------\r\n * Inventory: kits and staff issuance\r\n * ------------------------------------------------------------------------- */\r\n\r\n.hint-text {\r\n  font-size: 12.5px;\r\n  color: var(--text-muted);\r\n  margin: 4px 0 0;\r\n}\r\n\r\n.kit-items-editor {\r\n  margin-top: 20px;\r\n  pa