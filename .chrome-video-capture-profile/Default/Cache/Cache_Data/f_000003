;\r\n  display: flex;\r\n  align-items: end;\r\n  gap: 16px;\r\n}\r\n\r\n.accounts-filter-row .form-field {\r\n  width: 240px;\r\n}\r\n\r\n@media (max-width: 700px) {\r\n  .accounts-filter-row {\r\n    flex-direction: column;\r\n    align-items: stretch;\r\n  }\r\n\r\n  .accounts-filter-row .form-field {\r\n    width: 100%;\r\n  }\r\n}\r\n\r\n.accounts-summary-strip {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr);\r\n  gap: 18px;\r\n  margin-bottom: 18px;\r\n}\r\n\r\n@media (max-width: 1200px) {\r\n  .accounts-summary-strip {\r\n    grid-template-columns: repeat(2, 1fr);\r\n  }\r\n}\r\n\r\n@media (max-width: 700px) {\r\n  .accounts-summary-strip {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n.accounts-chart {\r\n  display: flex;\r\n  align-items: flex-end;\r\n  gap: 20px;\r\n  height: 200px;\r\n  padding: 16px 4px 0;\r\n  overflow-x: auto;\r\n}\r\n\r\n.accounts-chart-column {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: flex-end;\r\n  min-width: 56px;\r\n  height: 100%;\r\n}\r\n\r\n.accounts-chart-bars {\r\n  display: flex;\r\n  align-items: flex-end;\r\n  gap: 4px;\r\n  height: 170px;\r\n}\r\n\r\n.accounts-bar {\r\n  width: 16px;\r\n  min-height: 2px;\r\n  border-radius: 4px 4px 0 0;\r\n}\r\n\r\n.accounts-bar.income {\r\n  background: var(--success-600);\r\n}\r\n\r\n.accounts-bar.expense {\r\n  background: var(--danger-600);\r\n}\r\n\r\n.accounts-chart-label {\r\n  margin-top: 8px;\r\n  font-size: 12px;\r\n  color: var(--text-muted);\r\n  white-space: nowrap;\r\n}\r\n\r\n.accounts-breakdown {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr);\r\n  gap: 16px;\r\n  margin-top: 20px;\r\n  padding-top: 20px;\r\n  border-top: 1px solid var(--saas-border);\r\n}\r\n\r\n.accounts-breakdown div {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.accounts-breakdown span {\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n}\r\n\r\n.accounts-breakdown strong {\r\n  font-size: 18px;\r\n  color: var(--text-strong);\r\n}\r\n\r\n@media (max-width: 700px) {\r\n  .accounts-breakdown {\r\n    grid-template-columns: repeat(2, 1fr);\r\n  }\r\n}\r\n\r\n\r\n\r\n@media (max-width: 1200px) {\r\n  .report-summary-grid {\r\n    grid-template-columns: repeat(2, 1fr);\r\n  }\r\n}\r\n\r\n@media (max-width: 700px) {\r\n  .report-summary-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n/* Better Reports UI */\r\n\r\n.report-panel-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 18px;\r\n}\r\n\r\n.report-panel-header h3 {\r\n  margin: 0;\r\n  font-size: 22px;\r\n  color: var(--text-strong);\r\n  font-weight: 800;\r\n}\r\n\r\n.report-panel-header p {\r\n  margin: 6px 0 0;\r\n  color: var(--text-muted);\r\n  font-size: 14px;\r\n}\r\n\r\n.classic-filter-bar {\r\n  background: var(--surface-subtle);\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  padding: 16px;\r\n  margin-bottom: 14px;\r\n  display: grid;\r\n  grid-template-columns: 220px 1fr auto auto;\r\n  gap: 14px;\r\n  align-items: end;\r\n}\r\n\r\n.filter-control {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.filter-control label {\r\n  color: var(--text);\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n}\r\n\r\n.filter-control select,\r\n.filter-control input {\r\n  height: 42px;\r\n  border: 1px solid var(--border-strong);\r\n  background: var(--surface);\r\n  border-radius: 8px;\r\n  padding: 0 12px;\r\n  outline: none;\r\n  font-size: 14px;\r\n  color: var(--text-strong);\r\n}\r\n\r\n.filter-control select:focus,\r\n.filter-control input:focus {\r\n  border-color: var(--text-strong);\r\n  box-shadow: 0 0 0 3px rgba(37, 50, 75, 0.08);\r\n}\r\n\r\n.active-filter-list {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  margin-bottom: 14px;\r\n}\r\n\r\n.filter-chip {\r\n  background: var(--brand-50);\r\n  color: var(--text-strong);\r\n  border: 1px solid var(--brand-200);\r\n  border-radius: 999px;\r\n  padding: 7px 10px 7px 12px;\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.filter-chip button {\r\n  border: none;\r\n  background: var(--text-strong);\r\n  color: var(--surface);\r\n  border-radius: 50%;\r\n  width: 18px;\r\n  height: 18px;\r\n  cursor: pointer;\r\n  line-height: 16px;\r\n  font-size: 14px;\r\n}\r\n\r\n.report-table {\r\n  min-width: 1100px;\r\n}\r\n\r\n.report-table th {\r\n  background: var(--text-strong);\r\n  color: var(--surface);\r\n  font-weight: 700;\r\n  font-size: 13px;\r\n  white-space: nowrap;\r\n}\r\n\r\n.report-table td {\r\n  font-size: 14px;\r\n  white-space: nowrap;\r\n}\r\n\r\n.report-table tbody tr:hover {\r\n  background: var(--surface-subtle);\r\n}\r\n\r\n@media (max-width: 1000px) {\r\n  .classic-filter-bar {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .filter-value-control {\r\n    width: 100%;\r\n  }\r\n}\r\n\r\nh1,\r\nh2,\r\nh3,\r\nh4,\r\nh5,\r\nh6 {\r\n  font-family: \"Inter\", \"Segoe UI\", Arial, sans-serif;\r\n  letter-spacing: -0.02em;\r\n}\r\n\r\ninput,\r\nselect,\r\ntextarea,\r\nbutton {\r\n  font-family: \"Inter\", \"Segoe UI\", Arial, sans-serif;\r\n}\r\n\r\n.page-heading h2,\r\n.welcome-panel h2 {\r\n  font-weight: 800;\r\n}\r\n\r\n.stat-card h3,\r\n.summary-card strong,\r\n.overview-list strong {\r\n  font-weight: 800;\r\n}\r\n\r\n/* Report Column Sort */\r\n\r\n.sort-header {\r\n  width: 100%;\r\n  border: none;\r\n  background: transparent;\r\n  color: inherit;\r\n  padding: 0;\r\n  cursor: pointer;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  font-weight: 800;\r\n  font-size: 13px;\r\n  text-align: left;\r\n}\r\n\r\n.sort-header span:first-child {\r\n  white-space: nowrap;\r\n}\r\n\r\n.sort-icon {\r\n  min-width: 22px;\r\n  height: 22px;\r\n  border-radius: 50%;\r\n  background: rgba(255, 255, 255, 0.16);\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 13px;\r\n}\r\n\r\n.sort-header:hover .sort-icon,\r\n.sort-header.active .sort-icon {\r\n  background: var(--saas-primary);\r\n  color: var(--surface);\r\n}\r\n\r\n.active-sort-info {\r\n  margin-bottom: 12px;\r\n  background: var(--surface-subtle);\r\n  border: 1px solid var(--border);\r\n  color: var(--text);\r\n  padding: 10px 14px;\r\n  border-radius: 9px;\r\n  font-size: 14px;\r\n}\r\n\r\n.active-sort-info strong {\r\n  color: var(--text-strong);\r\n}\r\n\r\n/* Login Page */\r\n\r\n.login-page {\r\n  min-height: 100vh;\r\n  /* The photo lives at /home/schoolm1/public_html/banner.png on the server --\r\n     that's schoolment.com's docroot, a different subdomain/docroot than\r\n     login.schoolment.com (which serves this page from public_html/school-admin/).\r\n     Must be an absolute cross-origin URL: a root-relative \"/banner.png\" would\r\n     resolve against login.schoolment.com instead, where the file doesn't\r\n     exist. Cross-origin <img>/background-image loads don't need CORS headers\r\n     for plain display, so this works without any server-side change.\r\n     If this ever moves under login.schoolment.com's own docroot, switch back\r\n     to a root-relative path. */\r\n  background-image: linear-gradient(rgba(30, 27, 130, 0.55), rgba(37, 41, 219, 0.55)), url(\"https://schoolment.com/banner.png\");\r\n  background-size: cover;\r\n  background-position: center;\r\n  background-repeat: no-repeat;\r\n  background-color: var(--primary-hover);\r\n  background-blend-mode: normal, normal;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 24px;\r\n}\r\n\r\n.login-card {\r\n  width: 100%;\r\n  max-width: 460px;\r\n  background: var(--surface);\r\n  border-radius: 18px;\r\n  padding: 34px;\r\n  box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);\r\n}\r\n\r\n.login-brand {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 14px;\r\n  margin-bottom: 28px;\r\n}\r\n\r\n.login-logo {\r\n  width: 58px;\r\n  height: 58px;\r\n  border-radius: 14px;\r\n  background: linear-gradient(135deg, var(--brand-400), var(--saas-primary));\r\n  color: var(--surface);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  overflow: hidden;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.login-brand h1 {\r\n  margin: 0;\r\n  color: var(--text-strong);\r\n  font-size: 28px;\r\n  font-weight: 800;\r\n}\r\n\r\n.login-brand p {\r\n  margin: 5px 0 0;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.login-form h2 {\r\n  margin: 0;\r\n  color: var(--text-strong);\r\n  font-size: 24px;\r\n}\r\n\r\n.login-subtitle {\r\n  margin: 8px 0 22px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.login-field {\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.login-field label {\r\n  display: block;\r\n  color: var(--text);\r\n  font-size: 14px;\r\n  font-weight: 700;\r\n  margin-bottom: 7px;\r\n}\r\n\r\n.login-input {\r\n  height: 46px;\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: 10px;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 9px;\r\n  padding: 0 13px;\r\n  background: var(--surface-subtle);\r\n}\r\n\r\n.login-input input {\r\n  border: none;\r\n  background: transparent;\r\n  width: 100%;\r\n  color: var(--text-strong);\r\n  font-size: 15px;\r\n}\r\n\r\n/* Same fix as .topbar-search: the wrapper's :focus-within ring below is\r\n   the visible focus indicator, so suppress the input's own focus-visible\r\n   outline -- it has the same specificity as the global input:focus-visible\r\n   rule, so without this the two rules tie and source order decides, which\r\n   was letting a second, squared-off outline show inside the rounded\r\n   wrapper's own outline. */\r\n.login-input input:focus-visible {\r\n  outline: none;\r\n}\r\n\r\n.login-button {\r\n  width: 100%;\r\n  border: none;\r\n  background: var(--saas-primary);\r\n  color: var(--surface);\r\n  border-radius: 999px;\r\n  padding: 13px;\r\n