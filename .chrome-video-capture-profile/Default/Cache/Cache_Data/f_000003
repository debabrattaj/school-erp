p: 8px;\r\n  text-align: center;\r\n}\r\n\r\n/* Template variants -- mirror the three PDF layouts in app/pdf.py closely\r\n   enough that picking one here and downloading gives the same impression,\r\n   without needing to be pixel-identical (this is a live web preview, the\r\n   PDF is print output; they were never going to match to the pixel). */\r\n\r\n.report-card-paper.template-modern {\r\n  padding: 0;\r\n  overflow: hidden;\r\n  -webkit-print-color-adjust: exact;\r\n  print-color-adjust: exact;\r\n}\r\n\r\n.report-card-paper.template-modern .report-card-header {\r\n  background: linear-gradient(135deg, var(--saas-primary, #3461c1), #2c50a0);\r\n  border-bottom: 0;\r\n  padding: 20px 22px;\r\n}\r\n\r\n.report-card-paper.template-modern .report-card-header h1,\r\n.report-card-paper.template-modern .report-card-header p {\r\n  color: #fff;\r\n}\r\n\r\n.report-card-paper.template-modern .school-logo-box {\r\n  background: rgba(255, 255, 255, 0.12);\r\n  border-color: rgba(255, 255, 255, 0.35);\r\n}\r\n\r\n.report-card-paper.template-modern .report-card-title,\r\n.report-card-paper.template-modern .report-card-info-grid,\r\n.report-card-paper.template-modern .report-card-table-wrapper,\r\n.report-card-paper.template-modern .report-card-result-grid,\r\n.report-card-paper.template-modern .report-card-empty,\r\n.report-card-paper.template-modern .report-card-signatures {\r\n  padding-left: 22px;\r\n  padding-right: 22px;\r\n}\r\n\r\n.report-card-paper.template-modern .report-card-signatures {\r\n  padding-bottom: 22px;\r\n}\r\n\r\n.report-card-paper.template-modern .report-card-table th {\r\n  background: var(--saas-primary, #3461c1);\r\n  color: #fff;\r\n}\r\n\r\n.report-card-paper.template-modern .report-card-table tfoot td {\r\n  background: var(--primary-soft, #eef2fb);\r\n}\r\n\r\n.report-card-paper.template-compact {\r\n  padding: 14px;\r\n  font-size: 12px;\r\n}\r\n\r\n.report-card-paper.template-compact .report-card-header {\r\n  gap: 10px;\r\n  padding-bottom: 8px;\r\n}\r\n\r\n.report-card-paper.template-compact .school-logo-box {\r\n  height: 40px;\r\n  width: 40px;\r\n}\r\n\r\n.report-card-paper.template-compact .report-card-header h1 {\r\n  font-size: 16px;\r\n}\r\n\r\n.report-card-paper.template-compact .report-card-title {\r\n  padding: 8px 0 6px;\r\n}\r\n\r\n.report-card-paper.template-compact .report-card-title h2 {\r\n  font-size: 15px;\r\n}\r\n\r\n.report-card-paper.template-compact .report-card-info-grid > div,\r\n.report-card-paper.template-compact .report-card-result-grid > div {\r\n  min-height: 42px;\r\n  padding: 6px 10px;\r\n}\r\n\r\n.report-card-paper.template-compact .report-card-table th,\r\n.report-card-paper.template-compact .report-card-table td {\r\n  font-size: 11px;\r\n  padding: 5px 7px;\r\n}\r\n\r\n.report-card-paper.template-compact .report-card-signatures {\r\n  margin-top: 24px;\r\n}\r\n\r\n@media print {\r\n  body {\r\n    background: var(--surface);\r\n  }\r\n\r\n  .no-print,\r\n  .sidebar,\r\n  .app-header {\r\n    display: none !important;\r\n  }\r\n\r\n  .print-area {\r\n    border: 0;\r\n    box-shadow: none;\r\n    padding: 0;\r\n  }\r\n\r\n  .report-card-table-wrapper {\r\n    overflow: visible;\r\n  }\r\n\r\n  .report-card-table {\r\n    min-width: 0;\r\n  }\r\n}\r\n\r\n@media (max-width: 860px) {\r\n  .report-card-info-grid,\r\n  .report-card-result-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .report-card-header {\r\n    align-items: flex-start;\r\n  }\r\n}\r\n\r\n/* SaaS polish layer */\r\n/* ---------------------------------------------------------------------------\r\n * Design tokens\r\n *\r\n * One system, one place. Before this the stylesheet carried a hundred\r\n * distinct hex values -- six near-identical greys across two hundred uses,\r\n * and two different primaries -- which is what made the app read as\r\n * unpolished: nobody notices a wrong grey, they just register that nothing\r\n * quite lines up.\r\n *\r\n * The palette is deliberately calm. Education buyers respond to something\r\n * institutional rather than consumer-bright, so the primary is a considered\r\n * blue and the neutrals are a single cool slate ramp.\r\n *\r\n * The --saas-* names below are aliases kept so existing rules keep working.\r\n * New CSS should use the canonical names.\r\n * ------------------------------------------------------------------------- */\r\n:root {\r\n  /* Neutrals: one cool slate ramp, replacing six competing greys. */\r\n  --n-0: #ffffff;\r\n  --n-25: #fbfcfd;\r\n  --n-50: #f7f9fb;\r\n  --n-100: #eef1f5;\r\n  --n-200: #e1e6ed;\r\n  --n-300: #cbd3de;\r\n  --n-400: #97a2b3;\r\n  --n-500: #6b7789;\r\n  --n-600: #4d5769;\r\n  --n-700: #364152;\r\n  --n-800: #232c3b;\r\n  --n-900: #141b26;\r\n\r\n  /* Brand: a calm institutional blue, not a consumer purple. */\r\n  --brand-50: #f1f5fc;\r\n  --brand-100: #e0e9f8;\r\n  --brand-200: #c4d5f1;\r\n  --brand-300: #9bb8e6;\r\n  --brand-400: #6b93d6;\r\n  --brand-500: #4674c9;\r\n  --brand-600: #3461c1;\r\n  --brand-700: #2b4fa0;\r\n  --brand-800: #274281;\r\n  --brand-900: #243968;\r\n\r\n  /* Semantic. One green, one amber, one red -- not five of each. */\r\n  --success-50: #ecfdf3;\r\n  --success-100: #d1f0de;\r\n  --success-600: #15803d;\r\n  --success-700: #116932;\r\n  --warning-50: #fffaeb;\r\n  --warning-100: #fdeec5;\r\n  --warning-600: #b45309;\r\n  --warning-700: #92400e;\r\n  --danger-50: #fef3f2;\r\n  --danger-100: #fde0e2;\r\n  --danger-600: #be123c;\r\n  --danger-700: #9f1239;\r\n\r\n  /* Roles: what the rest of the stylesheet should reach for. */\r\n  --surface: var(--n-0);\r\n  --surface-subtle: var(--n-50);\r\n  --surface-soft: var(--n-100);\r\n  --bg-app: var(--n-50);\r\n\r\n  --border: var(--n-200);\r\n  --border-strong: var(--n-300);\r\n\r\n  --text-strong: var(--n-900);\r\n  --text: var(--n-700);\r\n  --text-muted: var(--n-500);\r\n  --text-subtle: var(--n-400);\r\n  --text-on-brand: var(--n-0);\r\n\r\n  --primary: var(--brand-600);\r\n  --primary-hover: var(--brand-700);\r\n  --primary-soft: var(--brand-50);\r\n  --primary-border: var(--brand-200);\r\n  --focus-ring: rgba(52, 97, 193, 0.22);\r\n\r\n  /* Elevation: three steps, used consistently, rather than ad-hoc shadows. */\r\n  --shadow-sm: 0 1px 2px rgba(20, 27, 38, 0.06);\r\n  --shadow-md: 0 8px 20px rgba(20, 27, 38, 0.07);\r\n  --shadow-lg: 0 20px 44px rgba(20, 27, 38, 0.10);\r\n\r\n  /* Radius and spacing: a rhythm, not a guess per component. */\r\n  --radius-sm: 6px;\r\n  --radius: 10px;\r\n  --radius-lg: 14px;\r\n  --radius-pill: 999px;\r\n\r\n  /* Aliases for rules written against the previous token names. */\r\n  --saas-bg: var(--bg-app);\r\n  --saas-surface: var(--surface);\r\n  --saas-surface-soft: var(--surface-soft);\r\n  --saas-border: var(--border);\r\n  --saas-border-strong: var(--border-strong);\r\n  --saas-text: var(--text-strong);\r\n  --saas-muted: var(--text-muted);\r\n  --saas-primary: var(--primary);\r\n  --saas-primary-hover: var(--primary-hover);\r\n  --saas-accent: var(--brand-500);\r\n  --saas-accent-soft: var(--primary-soft);\r\n  --saas-focus: var(--focus-ring);\r\n  --saas-shadow-sm: var(--shadow-sm);\r\n  --saas-shadow-md: var(--shadow-md);\r\n  --saas-shadow-lg: var(--shadow-lg);\r\n}\r\n\r\nbody {\r\n  margin: 0;\r\n  font-family: \"Inter\", \"Segoe UI\", Arial, sans-serif;\r\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(247, 246, 254, 0.97) 320px),\r\n    var(--saas-bg);\r\n  color: var(--saas-text);\r\n}\r\n\r\nbutton,\r\na,\r\ninput,\r\nselect,\r\ntextarea {\r\n  transition:\r\n    background-color 160ms ease,\r\n    border-color 160ms ease,\r\n    box-shadow 160ms ease,\r\n    color 160ms ease,\r\n    transform 160ms ease;\r\n}\r\n\r\n\r\n.topbar {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 15;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  height: 40px;\r\n  flex-shrink: 0;\r\n  padding: 0 24px;\r\n  margin-bottom: 16px;\r\n  background: transparent;\r\n  backdrop-filter: none;\r\n  -webkit-backdrop-filter: none;\r\n  border-bottom: 1px solid transparent;\r\n  pointer-events: none;\r\n  transition: background 200ms ease, backdrop-filter 200ms ease, border-color 200ms ease;\r\n}\r\n\r\n.topbar-scrolled {\r\n  background: rgba(247, 246, 254, 0.72);\r\n  backdrop-filter: blur(12px);\r\n  -webkit-backdrop-filter: blur(12px);\r\n  border-bottom: 1px solid var(--saas-border);\r\n}\r\n\r\n.topbar-actions {\r\n  pointer-events: auto;\r\n  position: relative;\r\n  z-index: 16;\r\n}\r\n\r\n.topbar-spacer {\r\n  flex: 1;\r\n}\r\n\r\n.topbar-search-wrap {\r\n  pointer-events: auto;\r\n  position: relative;\r\n  flex: 1;\r\n  margin-right: 20px;\r\n}\r\n\r\n.topbar-search {\r\n  position: relative;\r\n  z-index: 16;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  background: var(--saas-surface-soft);\r\n  border: 1px solid var(--saas-border);\r\n  border-radius: 999px;\r\n  padding: 4.5px 16px;\r\n  color: var(--saas-muted);\r\n}\r\n\r\n.topbar-search:focus-within {\r\n  border-color: var(--primary-border);\r\n  box-shadow: 0 0 0 3px var(--focus-ring);\r\n}\r\n\r\n.topbar-search input {\r\n  flex: 1;\r\n  border: none;\r\n  background: transparent;\r\n  font-size: 14px;\r\n  color: var(--saas-text);\r\n}\r\n\r\n/* The pill's own :focus-within ring above is the visible focus indicator\r\n   for this field -- suppress the input's own (redundant, and here\r\n   misaligned since it traces the input's box rather than the pill's)\r\n   focus-visible outline that the global a/button/input/select/textarea\r\n   rule further down would otherwise still draw. */\r\n.topbar-search input:focus-visible {\r\n  outline: none;\r\n}\r\n\r\n.topbar-search input::placeholder {\r\n  color: var(--saas-muted);\r\n}\r\n\r\n.topbar-search-backdrop {\r\n  position: fixed;\r\n  inset: 0;\r\n  background: rgba(15, 23, 42, 0.15);\r\n  z-index: 14;\r\n  pointer-events: auto;\r\n}\r\n\r\n.topbar-search-panel {\r\n  position: absolute;\r\n  top: 